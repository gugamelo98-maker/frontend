:root {
  --bg: #e9eef4;
  --piso: #dfe6ee;
  --card: #ffffff;
  --tx: #1d2733;
  --tx2: #5b6878;
  --tx3: #8a96a5;
  --linha: #d5dde7;
  --verde: #16a36a;
  --amarelo: #e0a100;
  --vermelho: #e5484d;
  --azul: #2f6fed;
  --sombra: 0 10px 30px rgba(30,50,80,.10), 0 2px 6px rgba(30,50,80,.06);
  --topo: rgba(255,255,255,.88);
  --sidebar: #ffffff;
  --hover: #f1f4f8;
}
[data-tema="escuro"] {
  --bg: #0f1419;
  --piso: #161b22;
  --card: #1c2330;
  --tx: #e6edf3;
  --tx2: #9aa7b5;
  --tx3: #6e7a88;
  --linha: #2a3441;
  --sombra: 0 10px 30px rgba(0,0,0,.35);
  --topo: rgba(22,27,34,.92);
  --sidebar: #161b22;
  --hover: #21262d;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  min-height: 100%;
  background: var(--bg);
  color: var(--tx);
  font-family: Inter, system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
}
button { font: inherit; cursor: pointer; border: none; background: none; }

/* LOGIN */
.login-veu {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(15,20,30,.55);
  display: grid; place-items: center;
  backdrop-filter: blur(6px);
}
.login-veu.hidden { display: none; }
.login-box {
  background: var(--card);
  border: 1px solid var(--linha);
  border-radius: 20px;
  padding: 32px 28px;
  width: min(380px, 92vw);
  text-align: center;
  box-shadow: var(--sombra);
}
.logo-lg {
  width: 56px; height: 56px; margin: 0 auto 14px;
  border-radius: 14px;
  background: linear-gradient(135deg,#2f6fed,#16a3a0);
  display: grid; place-items: center;
  color: #fff; font-weight: 800; font-size: 20px;
}
.login-box h1 { font-size: 18px; margin-bottom: 6px; }
.login-box p { font-size: 13px; color: var(--tx3); margin-bottom: 18px; }
.login-box input {
  width: 100%; padding: 12px 14px; border-radius: 10px;
  border: 1px solid var(--linha); background: var(--bg);
  color: var(--tx); font-size: 14px; margin-bottom: 10px;
}
.chave-err { min-height: 18px; font-size: 13px; color: var(--vermelho); margin-bottom: 8px; }
.btn-pri, .btn-sec {
  width: 100%; padding: 11px; border-radius: 10px;
  font-weight: 700; font-size: 14px; margin-top: 6px;
}
.btn-pri { background: var(--azul); color: #fff; }
.btn-sec { background: var(--hover); color: var(--tx2); border: 1px solid var(--linha); }

/* TOPO */
.top {
  position: sticky; top: 0; z-index: 40;
  display: flex; align-items: center; gap: 14px;
  padding: 12px 20px;
  background: var(--topo);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--linha);
}
.marca { display: flex; align-items: center; gap: 10px; }
.marca .logo {
  width: 36px; height: 36px; border-radius: 10px;
  background: linear-gradient(135deg,#2f6fed,#16a3a0);
  display: grid; place-items: center;
  color: #fff; font-weight: 800; font-size: 15px;
}
.marca h1 { font-size: 15px; font-weight: 700; }
.marca p { font-size: 11px; color: var(--tx3); }
.kpis { display: flex; gap: 8px; margin-left: auto; flex-wrap: wrap; }
.kpi {
  background: var(--card); border: 1px solid var(--linha);
  border-radius: 10px; padding: 6px 12px; min-width: 78px;
}
.kpi b { display: block; font-size: 16px; font-weight: 800; }
.kpi span { font-size: 10px; color: var(--tx3); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
.upd { font-size: 12px; color: var(--tx3); }
.conn {
  border: 1px solid var(--linha); background: var(--card);
  border-radius: 999px; padding: 7px 12px;
  font-size: 12px; font-weight: 700; color: var(--tx2);
  display: flex; align-items: center; gap: 6px;
}
.conn i { width: 8px; height: 8px; border-radius: 50%; background: #aab; }
.conn.on i { background: var(--verde); box-shadow: 0 0 0 3px rgba(22,163,106,.18); }
.conn.off i { background: var(--vermelho); }
.conn.demo i { background: var(--amarelo); }

.aviso {
  margin: 12px 20px 0; padding: 10px 14px; border-radius: 10px;
  background: #fff8e6; border: 1px solid #f2dca0; color: #7a5a00; font-size: 13px;
}
[data-tema="escuro"] .aviso { background: #2a2410; border-color: #5c4a1a; color: #e6c86a; }

/* LAYOUT */
.layout { display: flex; min-height: calc(100vh - 61px); }
.sidebar {
  width: 210px; flex-shrink: 0;
  background: var(--sidebar); border-right: 1px solid var(--linha);
  display: flex; flex-direction: column; padding: 12px 10px;
  position: sticky; top: 61px; height: calc(100vh - 61px);
}
.nav { display: flex; flex-direction: column; gap: 2px; flex: 1; }
.nv {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 10px;
  color: var(--tx2); font-size: 13px; font-weight: 600;
  width: 100%; text-align: left; transition: .15s;
}
.nv:hover { background: var(--hover); color: var(--tx); }
.nv.ativo { background: var(--azul); color: #fff; }
.nv .ico { font-size: 16px; width: 22px; text-align: center; }
.nv .badge {
  margin-left: auto; background: var(--vermelho); color: #fff;
  font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 999px;
}
.sb-fim { border-top: 1px solid var(--linha); padding-top: 10px; display: flex; flex-direction: column; gap: 2px; }

.content { flex: 1; padding: 20px; overflow: auto; }
.view { display: none; }
.view.ativo { display: block; }

.fbox {
  background: var(--card); border-radius: 16px; padding: 20px;
  box-shadow: var(--sombra); border: 1px solid var(--linha);
}
.fbox h2 { font-size: 18px; font-weight: 700; margin-bottom: 6px; }

/* SALAS */
.escritorio {
  margin-bottom: 24px; padding: 18px; border-radius: 22px;
  background:
    linear-gradient(0deg,rgba(255,255,255,.25),rgba(255,255,255,.25)),
    repeating-linear-gradient(90deg,#e3e9f0 0 1px,transparent 1px 64px),
    repeating-linear-gradient(0deg,#e3e9f0 0 1px,transparent 1px 64px),
    var(--piso);
  box-shadow: inset 0 0 0 1px var(--linha);
}
[data-tema="escuro"] .escritorio {
  background:
    linear-gradient(0deg,rgba(0,0,0,.2),rgba(0,0,0,.2)),
    repeating-linear-gradient(90deg,#1c2330 0 1px,transparent 1px 64px),
    repeating-linear-gradient(0deg,#1c2330 0 1px,transparent 1px 64px),
    var(--piso);
}
.salas { display: grid; grid-template-columns: repeat(auto-fill,minmax(260px,1fr)); gap: 16px; }
.sala {
  background: var(--card); border-radius: 18px; box-shadow: var(--sombra);
  overflow: hidden; cursor: pointer; transition: .2s; border: 1px solid var(--linha);
}
.sala:hover { transform: translateY(-3px); }
.sala-topo { display: flex; align-items: center; gap: 8px; padding: 12px 14px 0; }
.sala-topo .cor { width: 10px; height: 10px; border-radius: 3px; }
.sala-topo h2 { font-size: 14px; font-weight: 700; }
.sala-topo .cnt {
  margin-left: auto; font-size: 12px; font-weight: 600; color: var(--tx2);
  background: var(--hover); border-radius: 999px; padding: 3px 9px;
}
.cena {
  height: 150px; display: flex; align-items: flex-end; justify-content: center;
  gap: 10px; padding: 12px 8px 16px;
}
.agente { width: 64px; text-align: center; }
.agente .avatar {
  width: 48px; height: 48px; border-radius: 50%;
  background: linear-gradient(135deg,#a8c0ff,#3f2b96);
  margin: 0 auto 6px; display: grid; place-items: center;
  font-size: 18px; color: #fff; font-weight: 700;
  box-shadow: 0 4px 12px rgba(0,0,0,.15);
  animation: respira 4s ease-in-out infinite;
}
.agente.trabalhando .avatar {
  animation: digita 1.4s ease-in-out infinite;
  background: linear-gradient(135deg,#16a36a,#0d7a4d);
}
.agente .nome { font-size: 11px; font-weight: 700; color: var(--tx2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
@keyframes respira { 0%,100%{transform:translateY(0)} 50%{transform:translateY(2px)} }
@keyframes digita { 0%,100%{transform:translateY(0) rotate(0)} 25%{transform:translateY(1px) rotate(-2deg)} 75%{transform:translateY(1px) rotate(2deg)} }

/* ATENÇÃO */
.atencao {
  background: #fff8e6; border: 1px solid #f2dca0; border-radius: 14px;
  padding: 14px 16px; margin-bottom: 18px; color: #7a5a00;
}
[data-tema="escuro"] .atencao { background: #2a2410; border-color: #5c4a1a; color: #e6c86a; }
.atencao h3 { font-size: 14px; margin-bottom: 8px; }

/* CLIENTES */
.sec-topo { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 10px; }
.sec-topo h3 { font-size: 15px; font-weight: 700; }
.chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chip {
  font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 999px;
  border: 1px solid var(--linha); background: var(--card); color: var(--tx2); cursor: pointer;
}
.chip:hover, .chip.ativo { background: var(--azul); color: #fff; border-color: var(--azul); }
.lista-clientes { display: grid; grid-template-columns: repeat(auto-fill,minmax(260px,1fr)); gap: 12px; }
.card-cliente {
  background: var(--card); border: 1px solid var(--linha); border-radius: 14px;
  padding: 14px; box-shadow: var(--sombra); cursor: pointer; transition: .15s;
}
.card-cliente:hover { transform: translateY(-2px); }
.card-cliente .nome { font-weight: 700; font-size: 14px; margin-bottom: 4px; }
.card-cliente .meta { font-size: 12px; color: var(--tx3); display: flex; gap: 10px; flex-wrap: wrap; }
.card-cliente .status {
  display: inline-block; font-size: 11px; font-weight: 700;
  padding: 2px 8px; border-radius: 6px; margin-top: 8px;
}
.status.andamento { background: #e8f4ff; color: #1a6bb8; }
.status.pago, .status.fechou, .status.assinou { background: #e6f7ef; color: #0d7a4d; }
.status.objecao, .status.parou { background: #fff4e5; color: #b36b00; }
.status.finalizado { background: #f0f0f0; color: #666; }

.crm-topo { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; flex-wrap: wrap; }
.crm-topo input {
  flex: 1; min-width: 200px; padding: 10px 14px; border-radius: 10px;
  border: 1px solid var(--linha); background: var(--bg); color: var(--tx); font-size: 14px;
}
.crm-lista { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
.crm-item {
  display: flex; align-items: center; gap: 12px; padding: 12px 14px;
  border-radius: 12px; border: 1px solid var(--linha); background: var(--bg); cursor: pointer;
}
.crm-item:hover { background: var(--hover); }

/* AGENTES / FINANCEIRO / ETC */
.ag-resumo, .fin-kpis { display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0; }
.ag-kpi {
  background: var(--bg); border: 1px solid var(--linha); border-radius: 12px;
  padding: 12px 16px; min-width: 120px;
}
.ag-kpi b { display: block; font-size: 20px; font-weight: 800; }
.ag-kpi span { font-size: 12px; color: var(--tx3); }
.ag-cards { display: grid; grid-template-columns: repeat(auto-fill,minmax(220px,1fr)); gap: 14px; }
.ag-card { background: var(--bg); border: 1px solid var(--linha); border-radius: 14px; padding: 16px; }
.ag-card h4 { font-size: 14px; margin-bottom: 8px; }
.ag-card .stats { font-size: 12px; color: var(--tx2); display: flex; flex-direction: column; gap: 4px; }

.lista-conversas { display: flex; flex-direction: column; gap: 8px; }
.conv-item {
  display: flex; gap: 12px; padding: 12px; border-radius: 12px;
  border: 1px solid var(--linha); background: var(--bg);
}
.conv-item .av {
  width: 40px; height: 40px; border-radius: 50%; background: var(--azul);
  color: #fff; display: grid; place-items: center; font-weight: 700; flex-shrink: 0;
}
.conv-item .txt { flex: 1; min-width: 0; }
.conv-item .nome { font-weight: 700; font-size: 13px; }
.conv-item .msg { font-size: 12px; color: var(--tx3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.tabela-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--linha); }
th { font-weight: 700; color: var(--tx3); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }

.numeros-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(220px,1fr)); gap: 12px; margin-top: 14px; }
.num-card { background: var(--bg); border: 1px solid var(--linha); border-radius: 12px; padding: 14px; }
.num-card .num { font-weight: 700; font-size: 14px; }
.num-card .origem { font-size: 12px; color: var(--tx3); margin-top: 4px; }
.num-card .st { margin-top: 8px; font-size: 11px; font-weight: 700; display: inline-block; padding: 2px 8px; border-radius: 6px; }
.st.ativo { background: #e6f7ef; color: #0d7a4d; }
.st.inativo { background: #f0f0f0; color: #666; }

/* MODAL */
.modal-veu {
  position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 100;
  display: grid; place-items: center; padding: 20px;
}
.modal {
  background: var(--card); border-radius: 16px; width: 100%; max-width: 480px;
  max-height: 80vh; overflow: auto; box-shadow: 0 20px 60px rgba(0,0,0,.3);
  border: 1px solid var(--linha);
}
.modal header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 18px; border-bottom: 1px solid var(--linha);
}
.modal header h3 { font-size: 16px; }
.modal .fechar { font-size: 18px; color: var(--tx3); padding: 4px 8px; }
.modal-body { padding: 18px; font-size: 14px; line-height: 1.5; }
.vazio { text-align: center; padding: 40px 20px; color: var(--tx3); font-size: 14px; }

@media (max-width: 800px) {
  .sidebar { display: none; }
  .kpis { display: none; }
}
